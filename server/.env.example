# TRAPSHIELD Server Configuration Template
# Copy this file to server/.env and adjust values for your environment.

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# Development default: http://localhost:3000
# Production default: https://trap-shield.vercel.app,https://trap-shield-r0gpwye6f-anixora-tech.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Connection String (Mongoose)
MONGODB_URI=mongodb://127.0.0.1:27017/trapshield

# JWT & Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_64_character_string_in_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=trapshield_token

# Seed Administrator Credentials (used only by 'npm run seed:admin')
ADMIN_EMAIL=admin@trapshield.local
ADMIN_PASSWORD=change_this_to_a_strong_password_minimum_12_chars

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SCAN_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_MAX=10

# Development DNS Resolver (resolves MongoDB Atlas SRV timeouts on restrictive LANs)
# Set to 'false' if you wish to use system default DNS in development.
DEV_CUSTOM_DNS=true
# Optional custom comma-separated DNS servers (defaults to Google Public DNS 8.8.8.8, 8.8.4.4)
# DEV_DNS_SERVERS=8.8.8.8,8.8.4.4
